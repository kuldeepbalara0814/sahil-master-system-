#!/bin/sh
# Pehredaar: push se pehle jaanch. Lagane ke liye (clone ke baad ek baar):  git config core.hooksPath .githooks
ROOT=$(git rev-parse --show-toplevel)
PY=${SAFEGUARD_PY:-}
[ -z "$PY" ] && for c in "$ROOT/.venv/bin/python" "$ROOT/../venv/bin/python"; do [ -x "$c" ] && PY="$c" && break; done
PY=${PY:-python3}
ZERO=0000000000000000000000000000000000000000
TESTS=--tests
[ "$SKIP_TESTS" = "1" ] && TESTS=
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$ZERO" ]; then
    [ "$remote_ref" = "refs/heads/main" ] && { echo "PEHREDAAR ROKA: main branch delete nahi hogi"; exit 1; }
    continue
  fi
  if [ "$remote_sha" = "$ZERO" ]; then
    base=$(git rev-parse "$local_sha~1" 2>/dev/null) || continue
  else
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      echo "PEHREDAAR ROKA: force push / GitHub par naya kaam hai. Pehle 'git pull --rebase' karo."
      exit 1
    fi
    base=$remote_sha
  fi
  "$PY" "$ROOT/scripts/safeguard.py" --base "$base" --head "$local_sha" $TESTS || exit 1
done
exit 0
